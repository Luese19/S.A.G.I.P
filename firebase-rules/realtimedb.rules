{
  "rules": {
    "matchMaking": {
      "queue": {
        // Authenticated users can read the entire queue to find matches
        ".read": "auth != null",
        // Users can only write their own entry
        "$userId": {
          ".write": "auth != null && auth.uid == $userId"
        }
      }
    },

    "inGame": {
      // Authenticated users can create matches
      ".read": "auth != null",
      ".write": "auth != null",
      "$matchId": {
        // Match participants can read and write to their match
        ".read": "auth != null && (data.child('players/playerA').val() == auth.uid || data.child('players/playerB').val() == auth.uid)",
        ".write": "auth != null && (data.child('players/playerA').val() == auth.uid || data.child('players/playerB').val() == auth.uid || !data.exists())"
      }
    },

    // Admin functions (for server-side operations)
    "admin": {
      ".read": false,
      ".write": false
    },

    // Public read-only data (if needed)
    "public": {
      ".read": "auth != null",
      ".write": false
    }
  }
}